{
 "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
 "title": {
  "text": "Air temperature and precipitation at Wien Hohe Warte, 10-minute data 2020–2024",
  "subtitle": "Temperature follows a strong annual cycle (summer highs, winter lows) with a day–night swing visible in every week, while rain falls in short, intense 10-minute bursts. Drag in the overview to choose the detail period. Data: GeoSphere Austria (CC BY 4.0).",
  "anchor": "start",
  "subtitleFontSize": 12
 },
 "data": {
  "url": "https://raw.githubusercontent.com/denisseram/dataset-snapshots/3731e02e38c75e5d70ae92bf3596a69951866c2d/geosphere_wien_10min_2020-2024.csv",
  "format": {
   "type": "csv",
   "parse": {
    "time": "date",
    "tl": "number",
    "rr": "number"
   }
  }
 },
 "config": {
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFontSize": 11,
   "titleFontSize": 12
  }
 },
 "vconcat": [
  {
   "title": {
    "text": "Overview: daily mean (line) and daily min–max range (band) of air temperature — drag to select a period",
    "fontSize": 12,
    "anchor": "start"
   },
   "width": 1220,
   "height": 190,
   "transform": [
    {
     "timeUnit": "utcyearmonthdate",
     "field": "time",
     "as": "day"
    },
    {
     "aggregate": [
      {
       "op": "mean",
       "field": "tl",
       "as": "tl_mean"
      },
      {
       "op": "min",
       "field": "tl",
       "as": "tl_min"
      },
      {
       "op": "max",
       "field": "tl",
       "as": "tl_max"
      },
      {
       "op": "sum",
       "field": "rr",
       "as": "rr_sum"
      },
      {
       "op": "count",
       "as": "n"
      }
     ],
     "groupby": [
      "day"
     ]
    },
    {
     "calculate": "datum.day",
     "as": "time"
    }
   ],
   "encoding": {
    "x": {
     "field": "time",
     "type": "temporal",
     "scale": {
      "type": "utc"
     },
     "axis": {
      "title": "Date (UTC)",
      "format": "%b %Y",
      "labelAngle": 0,
      "grid": false
     }
    }
   },
   "layer": [
    {
     "params": [
      {
       "name": "brush",
       "select": {
        "type": "interval",
        "encodings": [
         "x"
        ]
       },
       "value": {
        "x": [
         {
          "year": 2024,
          "month": 7,
          "date": 8,
          "utc": true
         },
         {
          "year": 2024,
          "month": 7,
          "date": 15,
          "utc": true
         }
        ]
       }
      }
     ],
     "mark": {
      "type": "area",
      "color": "#9ecae1",
      "opacity": 0.6
     },
     "encoding": {
      "y": {
       "field": "tl_min",
       "type": "quantitative",
       "title": "Air temperature (°C)"
      },
      "y2": {
       "field": "tl_max"
      }
     }
    },
    {
     "mark": {
      "type": "line",
      "color": "#08519c",
      "strokeWidth": 0.8
     },
     "encoding": {
      "y": {
       "field": "tl_mean",
       "type": "quantitative"
      },
      "tooltip": [
       {
        "field": "time",
        "type": "temporal",
        "title": "Day (UTC)",
        "format": "%Y-%m-%d",
        "scale": {
         "type": "utc"
        }
       },
       {
        "field": "tl_mean",
        "type": "quantitative",
        "title": "Mean °C",
        "format": ".1f"
       },
       {
        "field": "tl_min",
        "type": "quantitative",
        "title": "Min °C",
        "format": ".1f"
       },
       {
        "field": "tl_max",
        "type": "quantitative",
        "title": "Max °C",
        "format": ".1f"
       },
       {
        "field": "rr_sum",
        "type": "quantitative",
        "title": "Precip. mm/day",
        "format": ".1f"
       },
       {
        "field": "n",
        "type": "quantitative",
        "title": "10-min readings"
       }
      ]
     }
    }
   ]
  },
  {
   "title": {
    "text": "Detail: individual 10-minute readings in the selected period",
    "fontSize": 12,
    "anchor": "start"
   },
   "width": 1220,
   "height": 260,
   "transform": [
    {
     "filter": {
      "param": "brush"
     }
    }
   ],
   "mark": {
    "type": "line",
    "color": "#d94801",
    "strokeWidth": 1,
    "point": {
     "size": 6,
     "filled": true,
     "color": "#d94801"
    }
   },
   "encoding": {
    "x": {
     "field": "time",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": {
       "param": "brush",
       "encoding": "x"
      }
     },
     "axis": {
      "title": null,
      "labelAngle": 0
     }
    },
    "y": {
     "field": "tl",
     "type": "quantitative",
     "title": "Air temperature (°C)",
     "scale": {
      "zero": false
     }
    },
    "tooltip": [
     {
      "field": "time",
      "type": "temporal",
      "title": "Time (UTC)",
      "format": "%Y-%m-%d %H:%M",
      "scale": {
       "type": "utc"
      }
     },
     {
      "field": "tl",
      "type": "quantitative",
      "title": "Temperature °C",
      "format": ".1f"
     },
     {
      "field": "rr",
      "type": "quantitative",
      "title": "Precip. mm/10 min",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "width": 1220,
   "height": 120,
   "transform": [
    {
     "filter": {
      "param": "brush"
     }
    },
    {
     "filter": "datum.rr > 0"
    },
    {
     "calculate": "datum.time - 600000",
     "as": "t_start"
    }
   ],
   "mark": {
    "type": "rect",
    "color": "#08519c",
    "stroke": "#08519c",
    "strokeWidth": 0.6
   },
   "encoding": {
    "x": {
     "field": "t_start",
     "type": "temporal",
     "scale": {
      "type": "utc",
      "domain": {
       "param": "brush",
       "encoding": "x"
      }
     },
     "axis": {
      "title": "Time (UTC)",
      "labelAngle": 0
     }
    },
    "y": {
     "field": "rr",
     "type": "quantitative",
     "title": "Precipitation (mm per 10 min)"
    },
    "tooltip": [
     {
      "field": "time",
      "type": "temporal",
      "title": "Time (UTC)",
      "format": "%Y-%m-%d %H:%M",
      "scale": {
       "type": "utc"
      }
     },
     {
      "field": "rr",
      "type": "quantitative",
      "title": "Precip. mm/10 min",
      "format": ".1f"
     }
    ],
    "x2": {
     "field": "time"
    }
   },
   "title": {
    "text": "Detail: precipitation per 10-minute interval (bar spans the interval ending at the time stamp)",
    "fontSize": 12,
    "anchor": "start"
   }
  }
 ]
}