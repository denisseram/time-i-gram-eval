{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Monthly mean water temperature by sensor depth, Birchy Head, Nova Scotia (2018–2025)",
    "subtitle": "Each summer the shallow water (2–5 m) warms to about 16–18 °C while the 30–40 m layer stays far cooler and peaks later, in autumn, and in winter all depths converge at about 1–4 °C.",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "subtitlePadding": 6
  },
  "width": 1180,
  "height": 560,
  "data": {
    "url": "https://raw.githubusercontent.com/rfordatascience/tidytuesday/6753376ef104727ef0ca3e3db6f2ca580c0d5a7b/data/2026/2026-03-31/ocean_temperature.csv",
    "format": {
      "type": "csv",
      "parse": {
        "date": "date:'%Y-%m-%d'",
        "sensor_depth_at_low_tide_m": "number",
        "mean_temperature_degree_c": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.mean_temperature_degree_c) && isFinite(datum.mean_temperature_degree_c)"
    },
    {
      "timeUnit": "yearmonth",
      "field": "date",
      "as": "month"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "mean_temperature_degree_c",
          "as": "temp"
        },
        {
          "op": "count",
          "as": "days"
        }
      ],
      "groupby": [
        "month",
        "sensor_depth_at_low_tide_m"
      ]
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 0.5
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "timeUnit": "yearmonth",
      "bandPosition": 0,
      "title": "Month (blank cell = no data for that depth in that month)",
      "axis": {
        "format": "%Y",
        "tickCount": {
          "interval": "year",
          "step": 1
        },
        "labelAlign": "left",
        "grid": false,
        "labelFontSize": 12,
        "titleFontSize": 13
      }
    },
    "y": {
      "field": "sensor_depth_at_low_tide_m",
      "type": "ordinal",
      "sort": "ascending",
      "title": "Sensor depth at low tide (m)",
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 13
      }
    },
    "color": {
      "field": "temp",
      "type": "quantitative",
      "title": "Monthly mean temperature (°C)",
      "scale": {
        "scheme": "redyellowblue",
        "reverse": true
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 400,
        "titleFontSize": 12,
        "labelFontSize": 11,
        "titleLimit": 400
      }
    },
    "tooltip": [
      {
        "field": "month",
        "type": "temporal",
        "timeUnit": "yearmonth",
        "title": "Month"
      },
      {
        "field": "sensor_depth_at_low_tide_m",
        "type": "ordinal",
        "title": "Depth (m)"
      },
      {
        "field": "temp",
        "type": "quantitative",
        "format": ".2f",
        "title": "Mean temp (°C)"
      },
      {
        "field": "days",
        "type": "quantitative",
        "title": "Days with data"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}